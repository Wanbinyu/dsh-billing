{
  "name": "dsh-billing-community-bundle",
  "version": "0.6.2",
  "description": "Installable DeepSeek Harness bundle for the dsh-billing host projection and client UI",
  "type": "module",
  "main": "./packages/dsh-billing/lib/index.js",
  "types": "./packages/dsh-billing/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./packages/dsh-billing/lib/index.d.ts",
      "default": "./packages/dsh-billing/lib/index.js"
    },
    "./invariant": {
      "types": "./packages/dsh-billing/lib/invariant.d.ts",
      "default": "./packages/dsh-billing/lib/invariant.js"
    },
    "./types": {
      "types": "./packages/dsh-billing/lib/types.d.ts",
      "default": "./packages/dsh-billing/lib/types.js"
    },
    "./client": {
      "types": "./packages/dsh-client-ui-billing/lib/types/client/index.d.ts",
      "default": "./packages/dsh-client-ui-billing/lib/community-client.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "cordis.patch.yml",
    "packages/dsh-billing/lib",
    "packages/dsh-billing/package.json",
    "packages/dsh-client-ui-billing/lib",
    "packages/dsh-client-ui-billing/package.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p packages/dsh-billing/tsconfig.json",
    "build:client": "npm run build:client:types && npm --prefix packages/dsh-client-ui-billing run bundle",
    "build:client:types": "tsc -p packages/dsh-client-ui-billing/tsconfig.json",
    "typecheck": "npm run build:host && npm run typecheck:host && npm run typecheck:client",
    "typecheck:host": "tsc -p packages/dsh-billing/tsconfig.json --noEmit",
    "typecheck:client": "tsc -p packages/dsh-client-ui-billing/tsconfig.json --noEmit",
    "test": "vitest run packages/dsh-billing/tests packages/dsh-client-ui-billing/tests",
    "pack:check": "npm pack --dry-run",
    "verify": "npm run typecheck && npm test && npm run pack:check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.0-rc.6 || ^0.1.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.1",
    "@deepseek-ai/dsh-brand": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.1",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session": "0.1.1-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.1-rc.1",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.1.1-rc.1",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "dsh-billing": "file:packages/dsh-billing",
    "dsh-client-ui-billing": "file:packages/dsh-client-ui-billing",
    "lightningcss": "^1.33.0",
    "react": "^18.3.1",
    "tsdown": "^0.20.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.8"
  }
}
